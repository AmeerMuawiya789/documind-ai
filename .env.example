# ─── DocuMind AI — environment variables ─────────────────────────────
# Copy to .env (local) or set in Vercel project settings. Never commit secrets.

# Supabase (required) — from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never public

# AI provider (required for chat / summaries / extraction / comparison)
# Any OpenAI-compatible chat-completions + embeddings endpoint works.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-ai-api-key
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Set to "true" to run the app with deterministic mock AI responses (tests, demos)
DOCUMIND_MOCK_AI=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Uploads
MAX_UPLOAD_MB=20

# Rate limiting (per user, per minute; set 0 to disable in dev)
RATE_LIMIT_PER_MINUTE=30

# Billing is removed — DocuMind AI is free for everyone.
# NOTE: every AI call is billed to YOUR AI_API_KEY (OpenRouter).
# The rate limiter above is your main protection against abuse.
